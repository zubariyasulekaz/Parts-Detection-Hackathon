# Copy this file to .env (or .env.local) and adjust for your environment.

# "mock"  -> the UI runs entirely against src/mocks, no backend required.
# "live"  -> the UI calls the FastAPI backend configured below.
VITE_API_MODE=mock

# FastAPI origin. No trailing slash, no /api/v1 suffix (that's VITE_API_PREFIX).
VITE_API_BASE_URL=http://localhost:8000

# Must match Settings.API_PREFIX in partpilot/backend/config/settings.py.
VITE_API_PREFIX=/api/v1

# Number of candidate SKUs requested from POST /predict.
VITE_PREDICTION_TOP_K=5

# Whether to ask Brain 4 (Qwen) for a natural-language explanation.
# Set to "false" if the LLM weights cannot be downloaded on your network -
# the backend degrades to no explanation either way, but skipping the call
# avoids waiting on the failed model load on the first request.
VITE_PREDICTION_EXPLAIN=true

# "true" runs the guided questions through the backend chat API
# (POST /chat/start, /chat/{id}/answer) so the server owns the conversation.
# Only takes effect in live mode; mock mode always uses the local logic,
# which the API mirrors one-for-one.
VITE_CHAT_API=True
