# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.claude/ 
# --- environment / secrets ---------------------------------------------------------------
.env
*.env.local

# --- testing / tooling ---------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- IDE ---------------------------------------------------------------
.vscode/
.idea/

# --- OS ---------------------------------------------------------------
.DS_Store
Thumbs.db

# --- PartPilot runtime artifacts (models, indexes, uploads, generated data) ---------------------------------------------------------------
backend/data/catalog/*
!backend/data/catalog/.gitkeep
backend/data/embeddings/*
!backend/data/embeddings/.gitkeep
backend/data/indexes/*
!backend/data/indexes/.gitkeep
backend/data/uploads/*
!backend/data/uploads/.gitkeep

backend/models/classifier/*
!backend/models/classifier/.gitkeep
backend/models/clip/*
!backend/models/clip/.gitkeep
backend/models/faiss/*
!backend/models/faiss/.gitkeep
# Local safety copies taken before an index rebuild. The rule above only
# covers files inside faiss/, so a sibling backup directory would otherwise
# be untracked-but-not-ignored, which is exactly what "stage all" picks up.
backend/models/faiss_backup*/

datasets/*
!datasets/.gitkeep
notebooks/.ipynb_checkpoints/
