# Copy this file to `.env` and adjust values for your environment.
# See backend/config/settings.py for the authoritative list of fields.

# --- application ---------------------------------------------------------------
APP_NAME=PartPilot
ENV=development
DEBUG=true

# --- server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- filesystem paths ---------------------------------------------------------------
MODEL_PATH=backend/models/classifier
CLIP_MODEL_PATH=backend/models/clip
FAISS_PATH=backend/models/faiss
UPLOAD_PATH=backend/data/uploads

# --- database (Brain 3 product catalog) ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/partpilot

# Optional. Supabase's session-pooler connection string (IPv4-compatible).
# The direct DATABASE_URL host above resolves over IPv6 only - on a network
# with no IPv6 route, backend.core.database detects that at startup (a
# short, synchronous connect probe) and swaps to this URL automatically.
# Leave unset if you don't have a pooler URL; DATABASE_URL is then always
# used as-is, same as before.
DATABASE_URL_POOLER=

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- startup ---------------------------------------------------------------
# Load the Brain 1/2 weights and FAISS indexes while the server boots instead
# of inside the first request. Startup takes ~45s longer, but every request is
# then fast - otherwise whoever uploads first after a restart waits out the
# model load and their browser usually gives up first.
WARM_MODELS_ON_STARTUP=true

# Preload Brain 4 too, so the first upload doesn't pay the model load. The
# llama.cpp GGUF loads in seconds; set this false if you switch
# LLM_BACKEND=transformers, whose weights are far heavier.
WARM_BRAIN4_ON_STARTUP=true

# --- Brain 1: classifier ---------------------------------------------------------------
CLASSIFIER_INPUT_SIZE=224
CLASSIFIER_CONFIDENCE_THRESHOLD=0.5

# --- Brain 2: similarity search ---------------------------------------------------------------
# Where the catalog vectors live. "faiss" reads the index files in
# backend/models/faiss; "pgvector" queries the products table instead, which
# keeps each vector in the product's own row so the two cannot drift apart.
# Same vectors and same matches either way. Using pgvector requires
# `alembic upgrade head` and `scripts/load_embeddings_to_db.py` first.
VECTOR_STORE=faiss

# Model that turns an image into a vector. One of: openclip, siglip,
# siglip-large, siglip-so400m, dinov2, dinov2-large, any HuggingFace model id,
# or several joined with "+" to average their scores (e.g. dinov2+siglip).
# Changing this invalidates the FAISS indexes - rebuild with
# scripts/build_faiss_indexes.py after switching.
EMBEDDING_BACKEND=dinov2

# Categories that scored better on a different model than the default, as JSON.
# Measured with scripts/evaluate_brain2.py: DINOv2 wins overall but loses badly
# where every product in a category shares the same texture.
CATEGORY_BACKENDS={"Air Filter": "openclip", "Wheel Hub Assembly": "openclip", "Shock Absorber": "openclip"}

# Only used when the backend is openclip.
OPENCLIP_MODEL_NAME=ViT-B-32
OPENCLIP_PRETRAINED=openai

FAISS_TOP_K=10

# --- Brain 4: reasoning ---------------------------------------------------------------
HF_TOKEN=

# Which runtime generates the explanation. Same model, same prompt, same
# output - only the execution differs.
#   llamacpp     - quantised GGUF through llama.cpp. Several times faster on
#                  a CPU box and a ~1.1 GB download. Needs llama-cpp-python
#                  (see requirements.txt).
#   transformers - full-precision weights through HuggingFace transformers.
#                  No extra dependency, but measured ~23s per explanation on
#                  CPU here, which is too slow to put in front of a user.
# Brain 4 is optional either way: if the model cannot be loaded the
# orchestrator returns the Brain 1-3 answer with no explanation.
LLM_BACKEND=llamacpp

# Used when LLM_BACKEND=llamacpp.
LLM_GGUF_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
LLM_GGUF_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_CONTEXT_TOKENS=2048
# 0 lets llama.cpp choose based on the machine's core count.
LLM_THREADS=0

# Used when LLM_BACKEND=transformers.
LLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

LLM_MAX_NEW_TOKENS=256

# --- uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# --- security ---------------------------------------------------------------
# Leave unset to disable admin-endpoint auth in local development.
API_KEY=
