# Copy this file to `.env` and adjust values for your environment.
# See backend/config/settings.py for the authoritative list of fields.

# --- application ---------------------------------------------------------------
APP_NAME=RigidHitch Part Finder
ENV=development
DEBUG=true

# --- server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# On a server, list the frontend's real origin instead of the wildcard. With
# "*" the app disables credentials, because a browser rejects a wildcard origin
# on a response that also allows them - the request then fails as a network
# error with nothing useful in the console.
# CORS_ORIGINS=["https://partfinder.klizer.co"]

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- filesystem paths ---------------------------------------------------------------
UPLOAD_PATH=backend/data/uploads

# --- catalogue database ---------------------------------------------------------------
# Plain Postgres. Also read by alembic_rigidhitch/ and
# scripts/import_rigidhitch_catalog.py.
RIGIDHITCH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/PartPilot_RigidHitch
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- search index ---------------------------------------------------------------
# Must point at the folder holding rigidhitch.faiss, its ids/meta sidecars and
# rigidhitch.whiten.npz. An index without the whitening file still works and
# still returns matches - it just scores about 25 points lower, with no error.
RIGIDHITCH_FAISS_PATH=backend/models/faiss_rigidhitch

# --- product images ---------------------------------------------------------------
# Served from disk when RIGIDHITCH_IMAGE_DIR is set. On Linux, use a Linux path:
# a directory that does not exist is only a warning in the log, and the symptom
# is a page of grey placeholders rather than an error.
RIGIDHITCH_IMAGE_DIR=
RIGIDHITCH_IMAGE_BASE_URL=http://localhost:8000/rigidhitch-images

# --- embedding model ---------------------------------------------------------------
# Fallback only. The index records the model that built it - a fine-tuned
# checkpoint under backend/models/ - and that takes precedence. Changing this
# invalidates the index; rebuild after switching.
EMBEDDING_BACKEND=dinov2
FAISS_TOP_K=10

# --- startup ---------------------------------------------------------------
# Load the model and index while the server boots instead of inside the first
# request. Startup takes ~30s longer, but every request is then fast -
# otherwise whoever uploads first after a restart waits out the model load.
WARM_MODELS_ON_STARTUP=true

# --- uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# --- security ---------------------------------------------------------------
# Leave unset in local development. Set it before the app is reachable from
# outside.
API_KEY=
