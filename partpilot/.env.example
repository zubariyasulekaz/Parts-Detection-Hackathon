# Copy this file to `.env` and adjust values for your environment.
# See backend/config/settings.py for the authoritative list of fields.

# --- application ---------------------------------------------------------------
APP_NAME=PartPilot
ENV=development
DEBUG=true

# --- server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- filesystem paths ---------------------------------------------------------------
MODEL_PATH=backend/models/classifier
CLIP_MODEL_PATH=backend/models/clip
FAISS_PATH=backend/models/faiss
UPLOAD_PATH=backend/data/uploads

# --- database (Brain 3 product catalog) ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/partpilot
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Brain 1: classifier ---------------------------------------------------------------
CLASSIFIER_INPUT_SIZE=224
CLASSIFIER_CONFIDENCE_THRESHOLD=0.5

# --- Brain 2: similarity search ---------------------------------------------------------------
OPENCLIP_MODEL_NAME=ViT-B-32
OPENCLIP_PRETRAINED=openai
FAISS_TOP_K=10

# --- Brain 4: reasoning (future) ---------------------------------------------------------------
HF_TOKEN=

# --- uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# --- security ---------------------------------------------------------------
# Leave unset to disable admin-endpoint auth in local development.
API_KEY=
